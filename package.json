{
  "name": "magpie-hark-web",
  "version": "0.1.5",
  "description": "Magpie provider plugin for hark.com: sign in to each account in a browser window or connect to existing Chrome, use Hark in Codex, OpenCode and other agents, with tool calls and usage card",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "engine/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test contract.test.mjs \"test/*.test.mjs\""
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "hark",
    "hark-web",
    "hark-com"
  ],
  "author": "Antigravity Assistant",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 1
  }
}
